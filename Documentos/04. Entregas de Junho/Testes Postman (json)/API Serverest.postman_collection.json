				{
					"name": "TC015 - Finalização de compra",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Verifica se temos um carrinho válido\r",
									"if (!pm.environment.get(\"cart_id\")) {\r",
									"    console.log(\"Criando novo carrinho...\");\r",
									"    pm.sendRequest({\r",
									"        url: pm.variables.get(\"base_url\") + \"/carrinhos\",\r",
									"        method: \"POST\",\r",
									"        header: { \r",
									"            'Content-Type': 'application/json',\r",
									"            'Authorization': 'Bearer ' + pm.variables.get(\"auth_token\")\r",
									"        },\r",
									"        body: {\r",
									"            mode: 'raw',\r",
									"            raw: JSON.stringify({\r",
									"                produtos: [{\r",
									"                    idProduto: pm.variables.get(\"product_id\"),\r",
									"                    quantidade: 1\r",
									"                }]\r",
									"            })\r",
									"        }\r",
									"    }, function (err, res) {\r",
									"        if (err) {\r",
									"            console.error(\"Erro ao criar carrinho:\", err);\r",
									"        } else {\r",
									"            const cleanId = res.json()._id.replace(/[\\\\\\\"]/g, '');\r",
									"            pm.environment.set(\"cart_id\", cleanId);\r",
									"            console.log(\"Novo cart_id:\", cleanId);\r",
									"        }\r",
									"    });\r",
									"} else {\r",
									"    console.log(\"Usando cart_id existente:\", pm.environment.get(\"cart_id\"));\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Verificação principal\r",
									"pm.test(\"Status code is 200\", function() {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Success message exists\", function() {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.message).to.include(\"sucesso\");\r",
									"});\r",
									"\r",
									"// Verificação assíncrona do carrinho removido\r",
									"setTimeout(() => {\r",
									"    pm.sendRequest({\r",
									"        url: `${pm.variables.get(\"base_url\")}/carrinhos/${pm.variables.get(\"cart_id\")}`,\r",
									"        method: \"GET\",\r",
									"        header: { 'Authorization': `Bearer ${pm.variables.get(\"auth_token\")}` }\r",
									"    }, (err, res) => {\r",
									"        if (err) {\r",
									"            console.error(\"Erro na verificação:\", err);\r",
									"        } else {\r",
									"            pm.test(\"Cart should be deleted\", () => {\r",
									"                pm.expect(res.code).to.eql(404);\r",
									"            });\r",
									"        }\r",
									"    });\r",
									"}, 1000);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
